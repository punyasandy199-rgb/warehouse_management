rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SIKUTANG Warehouse Management System Security Rules
    
    // Racks collection
    match /racks/{rackId} {
      allow read, write: if true;
    }
    
    // Products collection
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Employees collection
    match /employees/{employeeId} {
      allow read, write: if true;
    }
    
    // Activity logs collection
    match /logs/{logId} {
      allow read, write: if true;
    }

    // Default catch-all for system configuration or test connections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
